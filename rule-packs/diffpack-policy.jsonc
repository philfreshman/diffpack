{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/rule-pack-schema.json",
	"version": 1,
	"name": "diffpack",
	"description": "Two invariants this codebase already holds, written down so they keep holding. Both report as policy-violation findings; both are at zero today.",
	"rules": [
		// CLAUDE.md calls the localStorage key names "a contract with returning
		// visitors": renaming one silently drops the settings of everybody who
		// already has it. There are seven settings and a search history per
		// registry, each declared once in src/lib/storage/settings.ts — the
		// module the e2e suite takes the keys from — and one file reads and
		// writes the store for all of them. A component reaching for
		// `localStorage` directly is how an eighth key, or a second spelling of
		// an existing one, gets in without anyone noticing.
		//
		// The scripts in `<head>` count too, and this rule cannot see a call
		// inside a string: that is how the diff boot script once read another
		// module's key unnoticed. So none of them spells out a read any more:
		// storedSetting.ts writes each one from the setting's declaration.
		//
		// Scoped to `src/**` on purpose. `tests/e2e/**` and
		// `scripts/capture-screenshots.mjs` drive the *browser's* localStorage
		// through `page.evaluate` to set up a fixture; that is not a preference
		// read, and parity.spec.ts exists precisely to address those keys from
		// the outside.
		{
			"id": "storage-keys-belong-to-the-storage-layer",
			"kind": "banned-call",
			"callees": ["localStorage.*"],
			"files": ["src/**"],
			"exclude": ["src/lib/storage/storedSetting.ts"],
			"message": "Declare the setting in src/lib/storage/settings.ts and read and write it through src/lib/storage/storedSetting.ts — useSetting in a component, readInHead in a <head> script. The key names are a compatibility contract — see CLAUDE.md.",
			"severity": "error"
		},

		// `Fetcher` in src/lib/registries/types.ts is documented as "the one
		// system boundary in this layer: injected so adapters stay testable".
		// Every adapter takes it as a parameter and every unit test passes
		// `stubFetch` in its place. An adapter that calls the global `fetch`
		// instead is untestable without a network, and the whole
		// tests/unit/registries suite quietly stops covering it.
		{
			"id": "registry-adapters-use-the-injected-fetcher",
			"kind": "banned-call",
			"callees": ["fetch"],
			"files": ["src/lib/registries/**"],
			"message": "Take the `Fetcher` as a parameter instead of calling the global `fetch`, so the adapter stays testable with `stubFetch`.",
			"severity": "error"
		}
	]
}
