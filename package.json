{
	"name": "diffpack",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 4321",
		"build": "vite build",
		"preview": "vite preview --port 4321 --strictPort",
		"generate-routes": "tsr generate",
		"generate-emphasis": "bun scripts/generate-theme-emphasis.ts",
		"test": "bun test tests/unit",
		"test:e2e": "playwright test",
		"test:networked": "bun test tests/networked",
		"screenshots": "bun scripts/capture-screenshots.mjs",
		"screenshot": "bun scripts/screenshot.ts",
		"lint": "oxlint --deny-warnings --report-unused-disable-directives",
		"format": "oxfmt --check",
		"typecheck": "tsc --noEmit",
		"badge": "fallow health --format badge > .github/badges/fallow-health.svg",
		"check:badge": "fallow health --format badge | diff -u .github/badges/fallow-health.svg -",
		"badge:coverage": "bun scripts/coverage-badge.ts",
		"check:coverage-badge": "bun scripts/coverage-badge.ts --check",
		"check:coverage-gaps": "bun scripts/check-lib-coverage-gaps.ts",
		"check:vectors": "bun scripts/check-cache-key-vectors.ts",
		"check:vectors:development": "bun scripts/check-cache-key-vectors.ts development",
		"ci-failure": "bun scripts/ci-failure.ts",
		"fallow": "fallow",
		"fallow:audit": "fallow audit",
		"prepare": "husky"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@philfreshman/diffpack-engine": "0.5.0",
		"@tanstack/react-query": "5.107.1",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.5",
		"@tanstack/react-store": "0.11.2",
		"@tanstack/react-virtual": "3.14.26",
		"highlight.js": "11.12.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"three": "0.187.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "1.65.0",
		"@tanstack/react-router-devtools": "1.167.3",
		"@tanstack/router-cli": "1.168.0",
		"@types/bun": "1.3.14",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/three": "0.187.0",
		"@vitejs/plugin-react": "6.2.1",
		"fallow": "3.41.0",
		"husky": "9.1.7",
		"nitro": "3.0.261103-rc",
		"oxc-transform-react": "0.157.0",
		"oxfmt": "0.77.0",
		"oxlint": "1.92.0",
		"typescript": "7.0.2",
		"vite": "8.3.6"
	}
}
